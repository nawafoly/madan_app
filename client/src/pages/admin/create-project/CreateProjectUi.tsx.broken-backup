                      </span>
                      <div>
                        <p className="text-sm font-semibold">ظلم تتم إضافة صورة غلاف بعد/p>
                        <p className="mt-1 text-xs leading-6 text-white/70">
                          سترتبط هوية المشروع بصريًا هنا بمجرد رفع الصورة الأساسية.
                        /p>
                      </div>
                    </div>
                  </div>
                )}

                <div className="absolute inset-0 bg-[linear-gradient(180deg,rgba(11,23,38,0.12)_0%,rgba(11,23,38,0.35)_38%,rgba(11,23,38,0.88)_100%)]" />

                <div className="absolute inset-x-0 bottom-0 p-4 text-white">
                  <div className="flex flex-wrap items-center gap-2">
                    <Badge className="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-white backdrop-blur-sm">
                      {statusLabels[formData.status]}
                    </Badge>
                    <Badge className="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-white backdrop-blur-sm">
                      {projectTypeLabels[formData.projectType]}
                    </Badge>
                    <span className="inline-flex items-center gap-2 rounded-full border border-white/15 bg-black/20 px-3 py-1 text-[11px] font-semibold text-white backdrop-blur-sm">
                      <span className={cn("h-1.5 w-1.5 rounded-full", activeSectionAppearance.dot)} />
                      <span>
                        {activeSectionStatus === "complete"
                          ? "طالقسم الحالي مكتمل
                          : "طالقسم الحالي يحتاج متابعة}
                      </span>
                    </span>
                  </div>

                  <div className="mt-4">
                    <p className="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/60">
                      Smart Project Builder
                    </p>
                    <h2 className="mt-2 text-xl font-semibold leading-tight">{projectDisplayTitle}</h2>
                    <p className="mt-1 text-xs leading-6 text-white/70">
                      {cleanStr(formData.locationAr) || sidebarDescription}
                    </p>
                  </div>

                  <div className="mt-4 rounded-[22px] border border-white/12 bg-white/10 px-3.5 py-3 backdrop-blur-sm">
                    <div className="flex items-center justify-between text-[11px] font-semibold text-white/70">
                      <span>طالتقدم العام/span>
                      <span>{completionPercent}%</span>
                    </div>
                    <div className="mt-2 h-2 overflow-hidden rounded-full bg-white/15">
                      <div
                        className="h-full rounded-full bg-white/85 transition-all"
                        style={{ width: `${completionPercent}%` }}
                      />
                    </div>
                    <div className="mt-3 flex items-center justify-between text-xs text-white/78">
                      <span>{completedSectionsCount}/{visibleSections.length}  سكشنات مكتملة/span>
                      <span>
                        {pendingSectionsCount === 0
                          ? "ظلا توجد نواقص
                          : `${pendingSectionsCount}  بحاجة متابعة}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div className="min-h-0 flex-1 overflow-y-auto p-4">
              <div className="space-y-4">
                <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-2">
                  <MetricCard
                    icon={CheckCircle2}
                    label="طالمكتمل
                    value={`${completedSectionsCount}/${visibleSections.length}`}
                    status={summaryPanelStatus}
                  />
                  <MetricCard
                    icon={CircleHelp}
                    label="طالمتبقي
                    value={`${pendingSectionsCount}  أقسام}
                    status={pendingSectionsCount === 0 ? "complete" : "incomplete"}
                  />
                </div>

                <div className="rounded-[24px] border border-slate-200/80 bg-slate-50/80 p-4 shadow-sm">
                  <div className="flex items-start justify-between gap-3">
                    <div className="min-w-0 text-right">
                      <p className="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                        القسم النشط
                      /p>
                      <h3 className="mt-1 text-base font-semibold text-slate-950">
                        {activeSectionConfig?.title}
                      </h3>
                      <p className="mt-1 text-xs leading-6 text-slate-500">
                        {sectionMeta[activeSectionId]}
                      </p>
                    </div>
                    <span
                      className={cn(
                        "inline-flex items-center gap-2 rounded-full border px-3 py-1 text-[11px] font-semibold",
                        activeSectionAppearance.badge
                      )}
                    >
                      <span className={cn("h-1.5 w-1.5 rounded-full", activeSectionAppearance.dot)} />
                      <span>{activeSectionStatus === "complete" ? "ظمكتمل : "طغير مكتمل}</span>
                    </span>
                  </div>

                  <p className="mt-3 text-xs leading-6 text-slate-500">
                    {activeSectionConfig?.description || sidebarChecklistDescription}
                  </p>
                </div>

                <div className="rounded-[24px] border border-slate-200/80 bg-slate-50/80 p-2.5 shadow-sm">
                  <div className="mb-2 flex items-center justify-between gap-3 px-1.5 pt-1">
                    <div className="text-right">
                      <p className="text-sm font-semibold text-slate-950">{sidebarTitle}</p>
                      <p className="text-xs text-slate-500">
                        تنقل حي مع تشخيص موحد لكل السكشنات.
                      /p>
                    </div>
                    <Badge className="rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-700">
                      {completedSectionsCount}/{visibleSections.length}
                    </Badge>
                  </div>

                  <div className="space-y-2">
                    {visibleSections.map((section, index) => {
                      const isActive = activeSection === section.id;
                      const sectionStatus = sectionStatuses[section.id];
                      const statusAppearance = getStatusAppearance(sectionStatus);

                      return (
                        <button
                          type="button"
                          key={section.id}
                          aria-controls={section.id}
                          aria-current={isActive ? "step" : undefined}
                          onClick={() => handleSectionSelect(section.id)}
                          className={`relative flex w-full items-center justify-between overflow-hidden rounded-2xl border px-3.5 py-3 text-right transition-all ${
                            isActive
                              ? "border-slate-900 bg-slate-900 text-white shadow-[0_16px_30px_-18px_rgba(15,23,42,0.7)]"
                              : "border-slate-200 bg-white/90 text-slate-700 hover:bg-white"
                          }`}
                        >
                          <span
                            aria-hidden="true"
                            className={`absolute inset-y-0 right-0 w-[3px] ${
                              isActive
                                ? sectionStatus === "complete"
                                  ? "bg-emerald-300/80"
                                  : "bg-red-300/80"
                                : statusAppearance.strip
                            }`}
                          />
                          <div className="min-w-0 text-right">
                            <div className="flex items-center justify-end gap-2">
                              <span
                                aria-hidden="true"
                                className={`h-1.5 w-1.5 rounded-full ${
                                  isActive
                                    ? sectionStatus === "complete"
                                      ? "bg-emerald-300"
                                      : "bg-red-300"
                                    : statusAppearance.dot
                                }`}
                              />
                              <p className="text-sm font-semibold">{section.title}</p>
                            </div>
                            <p
                              className={`mt-1 text-xs ${isActive ? "text-slate-200" : "text-slate-500"}`}
                            >
                              {sectionMeta[section.id]}
                            </p>
                          </div>

                          <div className="mr-4 flex items-center gap-3">
                            <span
                              className={`flex size-9 items-center justify-center rounded-xl text-xs font-semibold ${
                                isActive
                                  ? "bg-white/12 text-white"
                                  : "bg-slate-50 text-slate-700 shadow-sm"
                              }`}
                            >
                              {String(index + 1).padStart(2, "0")}
                            </span>
                            <ChevronLeft className="h-4 w-4 shrink-0" />
                          </div>
                        </button>
                      );
                    })}
                  </div>
                </div>

                <div className="rounded-[24px] border border-slate-200/80 bg-slate-50/80 p-4 shadow-sm">
                  <div className="mb-4 flex items-start justify-between gap-3">
                    <div className="text-right">
                      <p className="text-sm font-semibold text-slate-950">{sidebarChecklistTitle}</p>
                      <p className="text-xs leading-6 text-slate-500">
                        {activeSectionConfig?.title || sidebarChecklistDescription}
                      </p>
                    </div>
                    <Badge className="rounded-full border border-slate-200 bg-white px-3 py-1 text-slate-700">
                      {activeChecklistPendingCount === 0
                        ? "طجاهز
                        : `${activeChecklistPendingCount}  نواقص}
                    </Badge>
                  </div>

                  <div className="space-y-3">
                    {activeSectionChecklistItems.map((item) => {
                      const itemAppearance = getStatusAppearance(
                        item.ready ? "complete" : "incomplete"
                      );

                      return (
                        <div
                          key={item.label}
                          className="relative overflow-hidden rounded-2xl border border-white bg-white/90 px-3.5 py-3 shadow-sm"
                        >
                          <span
                            aria-hidden="true"
                            className={cn("absolute inset-y-0 right-0 w-[3px]", itemAppearance.strip)}
                          />
                          <div className="flex items-start justify-between gap-3">
                            <div className="min-w-0 text-right">
                              <p className="text-sm font-semibold text-slate-900">{item.label}</p>
                              <p className="mt-1 text-xs leading-6 text-slate-500">
                                {item.detail}
                              </p>
                            </div>
                            <span
                              className={cn(
                                "inline-flex items-center gap-2 rounded-full border px-2.5 py-1 text-[11px] font-semibold",
                                itemAppearance.badge
                              )}
                            >
                              <span className={cn("h-1.5 w-1.5 rounded-full", itemAppearance.dot)} />
                              <span>{item.ready ? "طجاهز : "ظناقص}</span>
                            </span>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>

                <div className="space-y-2">
                  <div className="px-1 text-right">
                    <p className="text-sm font-semibold text-slate-950">ظنظرة سريعة/p>
                    <p className="text-xs text-slate-500">
                      ملخص ثابت للهوية والأصول ووضع المشروع الحالي.
                    /p>
                  </div>
                  <div className="grid gap-3">
                    {resolvedSidebarMetrics.map((metric) => (
                      <MetricCard
                        key={metric.label}
                        icon={metric.icon}
                        label={metric.label}
                        value={metric.value}
                      />
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  );
}

