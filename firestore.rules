rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helpers
    ========================= */
    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUserData() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function lower(v) {
      return (v is string) ? v.lower() : "";
    }

    function myRole() {
      return (("role" in myUserData()) && (myUserData().role is string))
        ? lower(myUserData().role)
        : "guest";
    }

    function myIsActive() {
      return !userDocExists()
        ? false
        : (("active" in myUserData()) && (myUserData().active is bool))
          ? myUserData().active
          : (("isActive" in myUserData()) && (myUserData().isActive is bool))
            ? myUserData().isActive
            : true;
    }

    function isOwner() { return signedIn() && myIsActive() && myRole() == "owner"; }
    function isAdmin() { return signedIn() && myIsActive() && (myRole() == "admin" || isOwner()); }
    function isHr() { return signedIn() && myIsActive() && myRole() == "hr"; }
    function isStaff() { return signedIn() && myIsActive() && myRole() == "staff"; }
    function isAccountant() { return signedIn() && myIsActive() && myRole() == "accountant"; }
    function isClient() { return signedIn() && myIsActive() && myRole() == "client"; }

    function isOps() {
      return signedIn() && (isOwner() || isAdmin() || isAccountant() || isHr());
    }

    function myAllowPermissions() {
      return (("permissionsAllow" in myUserData()) && (myUserData().permissionsAllow is list))
        ? myUserData().permissionsAllow
        : [];
    }

    function myDenyPermissions() {
      return (("permissionsDeny" in myUserData()) && (myUserData().permissionsDeny is list))
        ? myUserData().permissionsDeny
        : [];
    }

    function roleDefaultPermissions() {
      return myRole() == "owner"
        ? [
            "dashboard.view",
            "projects.view",
            "projects.manage",
            "projects.publish",
            "investments.view",
            "investments.manage",
            "users.view",
            "users.manage",
            "messages.view",
            "messages.manage",
            "recruitment.view",
            "recruitment.manage",
            "employees.view",
            "employees.manage",
            "weekly_reports.manager_notes",
            "reports.view",
            "financial.view",
            "financial.edit",
            "settings.manage",
            "admin_accounts.manage"
          ]
        : myRole() == "admin"
          ? [
              "dashboard.view",
              "projects.view",
              "projects.manage",
              "projects.publish",
              "investments.view",
              "investments.manage",
              "users.view",
              "users.manage",
              "messages.view",
              "messages.manage",
              "reports.view",
              "settings.manage"
            ]
          : myRole() == "accountant"
            ? [
                "dashboard.view",
                "projects.view",
                "investments.view",
                "financial.view",
                "financial.edit",
                "reports.view"
              ]
            : myRole() == "hr"
              ? [
                  "recruitment.view",
                  "recruitment.manage",
                  "employees.view",
                  "employees.manage"
                ]
              : myRole() == "staff"
                ? []
                : myRole() == "client"
                  ? ["projects.view"]
                  : ["projects.view"];
    }

    function hasEffectivePermission(permission) {
      return signedIn()
        && myIsActive()
        && !(permission in myDenyPermissions())
        && ((permission in myAllowPermissions()) || (permission in roleDefaultPermissions()));
    }

    function hasAdminPermission(permission) {
      return (isOps() && hasEffectivePermission(permission))
        || hasAdminUserPermission(permission);
    }

    function canReadUsersAdmin() {
      return hasInvestmentAdminPermission("users.view")
        || hasInvestmentAdminPermission("users.manage")
        || hasInvestmentAdminPermission("settings.manage")
        || hasInvestmentAdminPermission("reports.view")
        || hasInvestmentAdminPermission("financial.view")
        || hasInvestmentAdminPermission("financial.edit");
    }

    function canManageUsersAdmin() {
      return hasInvestmentAdminPermission("users.manage")
        || hasInvestmentAdminPermission("settings.manage");
    }

    function canManageAdminAccounts() {
      return hasStaffAdminPermission("admin_accounts.manage");
    }

    function myAdminUserDocId() {
      return signedIn() && (request.auth.token.email is string)
        ? lower(request.auth.token.email)
        : "";
    }

    function adminUserDocExists() {
      return myAdminUserDocId() != ""
        && exists(/databases/$(database)/documents/admin_users/$(myAdminUserDocId()));
    }

    function myAdminUserData() {
      return adminUserDocExists()
        ? get(/databases/$(database)/documents/admin_users/$(myAdminUserDocId())).data
        : {};
    }

    function adminUserRoleValue() {
      return (("roleKey" in myAdminUserData()) && (myAdminUserData().roleKey is string))
        ? lower(myAdminUserData().roleKey)
        : (("role" in myAdminUserData()) && (myAdminUserData().role is string))
          ? lower(myAdminUserData().role)
          : "";
    }

    function adminUserIsActive() {
      return !adminUserDocExists()
        ? false
        : (("active" in myAdminUserData()) && (myAdminUserData().active is bool))
          ? myAdminUserData().active
          : (("isActive" in myAdminUserData()) && (myAdminUserData().isActive is bool))
            ? myAdminUserData().isActive
            : true;
    }

    function adminUserAllowPermissions() {
      return (("permissionsAllow" in myAdminUserData()) && (myAdminUserData().permissionsAllow is list))
        ? myAdminUserData().permissionsAllow
        : [];
    }

    function adminUserDenyPermissions() {
      return (("permissionsDeny" in myAdminUserData()) && (myAdminUserData().permissionsDeny is list))
        ? myAdminUserData().permissionsDeny
        : [];
    }

    function adminUserRoleDefaultPermissions() {
      return adminUserRoleValue() == "owner"
        ? [
            "dashboard.view",
            "projects.view",
            "projects.manage",
            "projects.publish",
            "investments.view",
            "investments.manage",
            "users.view",
            "users.manage",
            "messages.view",
            "messages.manage",
            "recruitment.view",
            "recruitment.manage",
            "employees.view",
            "employees.manage",
            "weekly_reports.manager_notes",
            "reports.view",
            "financial.view",
            "financial.edit",
            "settings.manage",
            "admin_accounts.manage"
          ]
        : adminUserRoleValue() == "admin"
          ? [
              "dashboard.view",
              "projects.view",
              "projects.manage",
              "projects.publish",
              "investments.view",
              "investments.manage",
              "users.view",
              "users.manage",
              "messages.view",
              "messages.manage",
              "reports.view",
              "settings.manage"
            ]
          : adminUserRoleValue() == "accountant"
            ? [
                "dashboard.view",
                "projects.view",
                "investments.view",
                "financial.view",
                "financial.edit",
                "reports.view"
              ]
            : adminUserRoleValue() == "hr"
              ? [
                  "recruitment.view",
                  "recruitment.manage",
                  "employees.view",
                  "employees.manage"
                ]
              : adminUserRoleValue() == "staff"
                ? []
                : adminUserRoleValue() == "client"
                  ? ["projects.view"]
                  : ["projects.view"];
    }

    function hasAdminUserPermission(permission) {
      return signedIn()
        && adminUserDocExists()
        && adminUserIsActive()
        && (adminUserRoleValue() in ["owner", "admin", "accountant", "hr"])
        && !(permission in adminUserDenyPermissions())
        && (
          (permission in adminUserAllowPermissions())
          || (permission in adminUserRoleDefaultPermissions())
        );
    }

    function hasAdminUserExplicitPermission(permission) {
      return signedIn()
        && adminUserDocExists()
        && adminUserIsActive()
        && !(permission in adminUserDenyPermissions())
        && (permission in adminUserAllowPermissions());
    }

    function isInvestmentAdminRoleValue(role) {
      return role in ["owner", "admin", "accountant"];
    }

    function isStaffAdminRoleValue(role) {
      return role in ["owner", "admin", "hr", "staff"];
    }

    function hasInvestmentUserPermission(permission) {
      return signedIn()
        && myIsActive()
        && isInvestmentAdminRoleValue(myRole())
        && !(permission in myDenyPermissions())
        && ((permission in myAllowPermissions()) || (permission in roleDefaultPermissions()));
    }

    function hasStaffUserPermission(permission) {
      return signedIn()
        && myIsActive()
        && isStaffAdminRoleValue(myRole())
        && !(permission in myDenyPermissions())
        && ((permission in myAllowPermissions()) || (permission in roleDefaultPermissions()));
    }

    function hasInvestmentAdminUserPermission(permission) {
      return signedIn()
        && adminUserDocExists()
        && adminUserIsActive()
        && isInvestmentAdminRoleValue(adminUserRoleValue())
        && !(permission in adminUserDenyPermissions())
        && (
          (permission in adminUserAllowPermissions())
          || (permission in adminUserRoleDefaultPermissions())
        );
    }

    function hasStaffAdminUserPermission(permission) {
      return signedIn()
        && adminUserDocExists()
        && adminUserIsActive()
        && isStaffAdminRoleValue(adminUserRoleValue())
        && !(permission in adminUserDenyPermissions())
        && (
          (permission in adminUserAllowPermissions())
          || (permission in adminUserRoleDefaultPermissions())
        );
    }

    function hasInvestmentAdminPermission(permission) {
      return hasInvestmentUserPermission(permission)
        || hasInvestmentAdminUserPermission(permission);
    }

    function hasStaffAdminPermission(permission) {
      return hasStaffUserPermission(permission)
        || hasStaffAdminUserPermission(permission);
    }

    function hasStaffAreaPermission(permission) {
      return hasStaffAdminPermission(permission)
        || (
          isStaff()
          && !(permission in myDenyPermissions())
          && ((permission in myAllowPermissions()) || (permission in roleDefaultPermissions()))
        )
        || (
          adminUserDocExists()
          && adminUserIsActive()
          && adminUserRoleValue() == "staff"
          && !(permission in adminUserDenyPermissions())
          && (
            (permission in adminUserAllowPermissions())
            || (permission in adminUserRoleDefaultPermissions())
          )
        );
    }

    function isBootstrapOwnerEmail() {
      return signedIn()
        && (
          lower(request.auth.token.email) == "abdullah@madanalbena.com"
          || (
            adminUserDocExists()
            && adminUserIsActive()
            && adminUserRoleValue() == "owner"
          )
        );
    }

    function roleFromData(data) {
      return (("role" in data) && (data.role is string))
        ? lower(data.role)
        : "";
    }

    function adminRoleFromData(data) {
      return (("roleKey" in data) && (data.roleKey is string))
        ? lower(data.roleKey)
        : roleFromData(data);
    }

    function isInvestmentAdminData(data) {
      return isInvestmentAdminRoleValue(adminRoleFromData(data));
    }

    function isStaffAdminData(data) {
      return adminRoleFromData(data) in ["hr", "staff"];
    }

    function canReadAdminUserData(data) {
      return (canManageAdminAccounts() && (isInvestmentAdminData(data) || isStaffAdminData(data)))
        || (canManageEmployeesAdmin() && adminRoleFromData(data) == "staff");
    }

    function canWriteAdminUserData(data) {
      return (canManageAdminAccounts() && (isInvestmentAdminData(data) || isStaffAdminData(data)))
        || (canManageEmployeesAdmin() && adminRoleFromData(data) == "staff");
    }

    function roleInviteRoleFromData(data) {
      return (("roleKey" in data) && (data.roleKey is string))
        ? lower(data.roleKey)
        : roleFromData(data);
    }

    function canAccessRoleInviteData(data) {
      let role = roleInviteRoleFromData(data);
      return canManageAdminAccounts() && role in ["owner", "admin", "accountant", "hr", "staff"];
    }

    function isStaffUserDoc(data) {
      return roleFromData(data) == "staff";
    }

    function employeeOwnerUid(data) {
      return (("uid" in data) && (data.uid is string))
        ? data.uid
        : (
            (("linkedUserUid" in data) && (data.linkedUserUid is string))
              ? data.linkedUserUid
              : (
                  (("userId" in data) && (data.userId is string))
                    ? data.userId
                    : ""
                )
          );
    }

    function profileMap(data) {
      return (("profile" in data) && (data.profile is map))
        ? data.profile
        : {};
    }

    function employmentMap(data) {
      return (("employment" in data) && (data.employment is map))
        ? data.employment
        : {};
    }

    function employeeProfileMap(data) {
      return (("employeeProfile" in data) && (data.employeeProfile is map))
        ? data.employeeProfile
        : {};
    }

    function employeePersonalMap(data) {
      let employeeProfile = employeeProfileMap(data);
      return (("personal" in employeeProfile) && (employeeProfile.personal is map))
        ? employeeProfile.personal
        : {};
    }

    function employeeEmploymentMap(data) {
      let employeeProfile = employeeProfileMap(data);
      return (("employment" in employeeProfile) && (employeeProfile.employment is map))
        ? employeeProfile.employment
        : {};
    }

    function canReadEmployeesAdmin() {
      return hasStaffAdminPermission("employees.view")
        || hasStaffAdminPermission("employees.manage");
    }

    function canManageEmployeesAdmin() {
      return hasStaffAdminPermission("employees.manage");
    }

    function hasEmployeeManagementMarker(data) {
      return (
          ("includeInEmployeeManagement" in data)
          && data.includeInEmployeeManagement == true
        )
        || (
          ("employeeProfileEnabled" in data)
          && data.employeeProfileEnabled == true
        )
        || (
          ("linkedEmployeeId" in data)
          && data.linkedEmployeeId is string
          && data.linkedEmployeeId.size() > 0
        );
    }

    function isEmployeeManagedUserDoc(data) {
      return !(("role" in data) && lower(data.role) in ["guest", "client"])
        || hasEmployeeManagementMarker(data);
    }

    function canReadRecruitmentAdmin() {
      return hasStaffAdminPermission("recruitment.view")
        || hasStaffAdminPermission("recruitment.manage");
    }

    function canManageRecruitmentAdmin() {
      return hasStaffAdminPermission("recruitment.manage");
    }

    function isValidEmployeeSelfProfileUpdate() {
      let keys = request.resource.data.diff(resource.data).changedKeys();
      return !keys.hasAny([
          "role",
          "permissionsAllow",
          "permissionsDeny",
          "active",
          "isActive",
          "isInvestor",
          "vipStatus",
          "linkedUserUid",
          "title",
          "jobTitle",
          "department",
          "startDate",
          "hireDate",
          "joinedAt",
          "leaveBalance",
          "status",
          "employmentStatus",
          "employeeCode",
          "fingerprintNumber",
          "employeeId",
          "adminNotes",
          "employment"
        ])
        && (!keys.hasAny(["email"]) || request.resource.data.email == request.auth.token.email)
        && (!keys.hasAny(["uid"]) || request.resource.data.uid == request.auth.uid)
        && (
          !keys.hasAny(["profile"])
          || profileMap(request.resource.data).diff(profileMap(resource.data)).changedKeys().hasOnly([
            "phone",
            "photoURL",
            "avatar"
          ])
        )
        && (
          !keys.hasAny(["employeeProfile"])
          || (
            employeeProfileMap(request.resource.data)
              .diff(employeeProfileMap(resource.data))
              .changedKeys()
              .hasOnly(["personal"])
            && employeePersonalMap(request.resource.data)
              .diff(employeePersonalMap(resource.data))
              .changedKeys()
              .hasOnly(["phone", "avatar"])
          )
        );
    }

    function isValidEmployeeAdminUpdate(userId) {
      let keys = request.resource.data.diff(resource.data).changedKeys();
      return (
          isEmployeeManagedUserDoc(resource.data)
          || isEmployeeManagedUserDoc(request.resource.data)
          || exists(/databases/$(database)/documents/employees/$(userId))
        )
        && !keys.hasAny([
            "role",
            "permissionsAllow",
            "permissionsDeny",
            "active",
            "isActive",
            "isInvestor",
            "vipStatus",
            "linkedUserUid",
            "uid"
          ])
        && keys.hasOnly([
            "displayName",
            "name",
            "fullName",
            "email",
            "phone",
            "photoURL",
            "profile",
            "title",
            "department",
            "startDate",
            "leaveBalance",
            "allowedZoneIds",
            "employeeProfileEnabled",
            "includeInEmployeeManagement",
            "linkedEmployeeId",
            "employment",
            "employeeProfile",
            "updatedAt"
          ])
        && (
          !keys.hasAny(["employment"])
          || employmentMap(request.resource.data).diff(employmentMap(resource.data)).changedKeys().hasOnly([
            "title",
            "jobTitle",
            "department",
            "startDate",
            "leaveBalance",
            "baseSalary",
            "housingAllowance",
            "transportationAllowance",
            "otherAllowances",
            "allowances",
            "expectedWorkDays",
            "expectedWorkHours",
            "actualWorkedHours",
            "workSchedule",
            "shiftStartTime",
            "shiftEndTime",
            "hoursDifference",
            "overtimeHours",
            "missingHours",
            "overtimeHourlyRate",
            "calculatedDailyRate",
            "calculatedHourlyRate",
            "calculatedOvertimeAmount",
            "calculatedMissingDeduction",
            "insuranceDeduction",
            "salaryDeductions",
            "totalSalaryDeductions",
            "calculatedGrossSalary",
            "calculatedNetSalary",
            "status",
            "employmentStatus",
            "employeeCode",
            "fingerprintNumber",
            "allowedZoneIds",
            "adminNotes",
            "leaveBalanceAdjustmentMeta",
            "updatedAt",
            "updatedByUid",
            "updatedByEmail"
          ])
        )
        && (
          !keys.hasAny(["profile"])
          || profileMap(request.resource.data).diff(profileMap(resource.data)).changedKeys().hasOnly([
            "name",
            "displayName",
            "email",
            "phone",
            "photoURL",
            "avatar"
          ])
        )
        && (
          !keys.hasAny(["employeeProfile"])
          || (
            employeeProfileMap(request.resource.data)
              .diff(employeeProfileMap(resource.data))
              .changedKeys()
              .hasOnly(["employment", "personal"])
            && (
              !employeeProfileMap(request.resource.data)
                .diff(employeeProfileMap(resource.data))
                .changedKeys()
                .hasAny(["employment"])
              || employeeEmploymentMap(request.resource.data)
                .diff(employeeEmploymentMap(resource.data))
                .changedKeys()
                .hasOnly([
                  "title",
                  "jobTitle",
                  "department",
                  "startDate",
                  "leaveBalance",
                  "baseSalary",
                  "housingAllowance",
                  "transportationAllowance",
                  "otherAllowances",
                  "allowances",
                  "expectedWorkDays",
                  "expectedWorkHours",
                  "actualWorkedHours",
                  "workSchedule",
                  "shiftStartTime",
                  "shiftEndTime",
                  "hoursDifference",
                  "overtimeHours",
                  "missingHours",
                  "overtimeHourlyRate",
                  "calculatedDailyRate",
                  "calculatedHourlyRate",
                  "calculatedOvertimeAmount",
                  "calculatedMissingDeduction",
                  "insuranceDeduction",
                  "salaryDeductions",
                  "totalSalaryDeductions",
                  "calculatedGrossSalary",
                  "calculatedNetSalary",
                  "status",
                  "employmentStatus",
                  "employeeCode",
                  "fingerprintNumber",
                  "allowedZoneIds",
                  "adminNotes",
                  "leaveBalanceAdjustmentMeta",
                  "updatedAt",
                  "updatedByUid",
                  "updatedByEmail"
                ])
            )
            && (
              !employeeProfileMap(request.resource.data)
                .diff(employeeProfileMap(resource.data))
                .changedKeys()
                .hasAny(["personal"])
              || employeePersonalMap(request.resource.data)
                .diff(employeePersonalMap(resource.data))
                .changedKeys()
                .hasOnly([
                  "name",
                  "email",
                  "phone",
                  "avatar"
                ])
            )
          )
        );
    }

    function isValidEmployeeCollectionSelfUpdate() {
      let keys = request.resource.data.diff(resource.data).changedKeys();
      return signedIn()
        && employeeOwnerUid(resource.data) == request.auth.uid
        && employeeOwnerUid(request.resource.data) == request.auth.uid
        && keys.hasOnly([
            "phone",
            "photoURL",
            "profile",
            "employeeProfile",
            "updatedAt"
          ])
        && (
          !keys.hasAny(["profile"])
          || profileMap(request.resource.data).diff(profileMap(resource.data)).changedKeys().hasOnly([
            "phone",
            "photoURL",
            "avatar"
          ])
        )
        && (
          !keys.hasAny(["employeeProfile"])
          || (
            employeeProfileMap(request.resource.data)
              .diff(employeeProfileMap(resource.data))
              .changedKeys()
              .hasOnly(["personal"])
            && employeePersonalMap(request.resource.data)
              .diff(employeePersonalMap(resource.data))
              .changedKeys()
              .hasOnly(["phone", "avatar"])
          )
        );
    }

    function leaveRequestOwnerUid(data) {
      return (("employeeUid" in data) && (data.employeeUid is string) && data.employeeUid.size() > 0)
        ? data.employeeUid
        : ((("userId" in data) && (data.userId is string) && data.userId.size() > 0)
          ? data.userId
          : "");
    }

    function isValidEmployeeLeaveRequestCreate() {
      return signedIn()
        && request.resource.data.employeeId is string
        && request.resource.data.employeeId.size() > 0
        && request.resource.data.employeeUid is string
        && request.resource.data.employeeUid.size() > 0
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && leaveRequestOwnerUid(request.resource.data) == request.auth.uid
        && requestStatusValue(request.resource.data) == "pending"
        && request.resource.data.leaveType is string
        && ("startDate" in request.resource.data)
        && request.resource.data.startDate != null
        && ("endDate" in request.resource.data)
        && request.resource.data.endDate != null
        && request.resource.data.daysCount is number
        && request.resource.data.daysCount > 0;
    }

    function isValidEmployeeLeaveRequestAdminUpdate() {
      let keys = request.resource.data.diff(resource.data).changedKeys();
      let beforeStatus = requestStatusValue(resource.data);
      let afterStatus = requestStatusValue(request.resource.data);
      return beforeStatus == "pending"
        && afterStatus in ["approved", "rejected"]
        && keys.hasOnly([
          "status",
          "hrNote",
          "decidedAt",
          "decidedBy",
          "decidedByEmail",
          "decidedByName",
          "reviewedAt",
          "reviewedBy",
          "reviewedByEmail",
          "reviewedByName",
          "updatedAt"
        ]);
    }

    function serviceRequestOwnerUid(data) {
      return (("employeeUid" in data) && (data.employeeUid is string) && data.employeeUid.size() > 0)
        ? data.employeeUid
        : ((("userId" in data) && (data.userId is string) && data.userId.size() > 0)
          ? data.userId
          : "");
    }

    function isValidEmployeeServiceRequestCreate() {
      return signedIn()
        && request.resource.data.employeeUid is string
        && request.resource.data.employeeUid.size() > 0
        && request.resource.data.userId is string
        && request.resource.data.userId == request.auth.uid
        && serviceRequestOwnerUid(request.resource.data) == request.auth.uid
        && requestStatusValue(request.resource.data) == "pending"
        && request.resource.data.requestType is string
        && request.resource.data.requestType in [
          "attendance_correction",
          "permission",
          "overtime",
          "salary_advance",
          "resignation",
          "exit_reentry",
          "letter"
        ];
    }

    function isValidEmployeeServiceRequestAdminUpdate() {
      let keys = request.resource.data.diff(resource.data).changedKeys();
      let beforeStatus = requestStatusValue(resource.data);
      let afterStatus = requestStatusValue(request.resource.data);
      return beforeStatus == "pending"
        && afterStatus in ["approved", "rejected"]
        && keys.hasOnly([
          "status",
          "hrNote",
          "decidedAt",
          "decidedBy",
          "decidedByEmail",
          "decidedByName",
          "reviewedAt",
          "reviewedBy",
          "reviewedByEmail",
          "reviewedByName",
          "updatedAt"
        ]);
    }

    function canReadMessagesAdmin() {
      return hasInvestmentAdminPermission("messages.view")
        || hasInvestmentAdminPermission("messages.manage");
    }

    function canManageMessagesAdmin() {
      return hasInvestmentAdminPermission("messages.manage");
    }

    function employeeMessageOwnerUid(data) {
      return (("employeeUid" in data) && (data.employeeUid is string))
        ? data.employeeUid
        : "";
    }

    function employeeMessageConversationValue(data, fallbackId) {
      return (("conversationId" in data) && (data.conversationId is string) && data.conversationId.size() > 0)
        ? data.conversationId
        : ((("threadId" in data) && (data.threadId is string) && data.threadId.size() > 0)
          ? data.threadId
          : fallbackId);
    }

    function employeeMessageConversationType(data) {
