rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helpers
    ========================= */
    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUserData() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // ✅ FIX: ترجع string دائمًا (بدون null) عشان يختفي تحذير الـ ternary
    function lower(v) {
      return (v is string) ? v.lower() : "";
    }

    // ✅ FIX: ترجع "guest" بدل null + تتحقق أن role string
    function myRole() {
      return (("role" in myUserData()) && (myUserData().role is string))
        ? lower(myUserData().role)
        : "guest";
    }

    function myIsActive() {
      return !userDocExists()
        ? false
        : (("active" in myUserData()) && (myUserData().active is bool))
          ? myUserData().active
          : (("isActive" in myUserData()) && (myUserData().isActive is bool))
            ? myUserData().isActive
            : true;
    }

    function isOwner() { return signedIn() && myIsActive() && myRole() == "owner"; }
    function isAdmin() { return signedIn() && myIsActive() && (myRole() == "admin" || isOwner()); }
    function isStaff() { return signedIn() && myIsActive() && myRole() == "staff"; }
    function isAccountant() { return signedIn() && myIsActive() && myRole() == "accountant"; }
    function isClient() { return signedIn() && myIsActive() && myRole() == "client"; }

    function isOps() {
      return signedIn() && (isOwner() || isAdmin() || isStaff() || isAccountant());
    }

    function myAllowPermissions() {
      return (("permissionsAllow" in myUserData()) && (myUserData().permissionsAllow is list))
        ? myUserData().permissionsAllow
        : [];
    }

    function myDenyPermissions() {
      return (("permissionsDeny" in myUserData()) && (myUserData().permissionsDeny is list))
        ? myUserData().permissionsDeny
        : [];
    }

    function roleDefaultPermissions() {
      return myRole() == "owner"
        ? [
            "dashboard.view",
            "projects.view",
            "projects.manage",
            "projects.publish",
            "investments.view",
            "investments.manage",
            "users.view",
            "users.manage",
            "messages.view",
            "messages.manage",
            "reports.view",
            "financial.view",
            "financial.edit",
            "settings.manage"
          ]
        : myRole() == "admin"
          ? [
              "dashboard.view",
              "projects.view",
              "projects.manage",
              "projects.publish",
              "investments.view",
              "investments.manage",
              "users.view",
              "users.manage",
              "messages.view",
              "messages.manage",
              "reports.view",
              "settings.manage"
            ]
          : myRole() == "accountant"
            ? [
                "dashboard.view",
                "projects.view",
                "investments.view",
                "financial.view",
                "financial.edit",
                "reports.view"
              ]
            : myRole() == "staff"
              ? ["dashboard.view", "projects.view", "messages.view"]
              : myRole() == "client"
                ? ["projects.view"]
                : ["projects.view"];
    }

    function hasEffectivePermission(permission) {
      return signedIn()
        && myIsActive()
        && !(permission in myDenyPermissions())
        && ((permission in myAllowPermissions()) || (permission in roleDefaultPermissions()));
    }

    function hasAdminPermission(permission) {
      return isOps() && hasEffectivePermission(permission);
    }

    function canReadUsersAdmin() {
      return hasAdminPermission("users.view")
        || hasAdminPermission("users.manage")
        || hasAdminPermission("settings.manage")
        || hasAdminPermission("reports.view")
        || hasAdminPermission("financial.view")
        || hasAdminPermission("financial.edit");
    }

    function canManageUsersAdmin() {
      return hasAdminPermission("users.manage")
        || hasAdminPermission("settings.manage");
    }

    function canReadMessagesAdmin() {
      return hasAdminPermission("messages.view")
        || hasAdminPermission("messages.manage");
    }

    function canManageMessagesAdmin() {
      return hasAdminPermission("messages.manage");
    }

    function canReadInvestmentsAdmin() {
      return hasAdminPermission("investments.view")
        || hasAdminPermission("investments.manage")
        || hasAdminPermission("financial.view")
        || hasAdminPermission("financial.edit")
        || hasAdminPermission("reports.view")
        || hasAdminPermission("projects.manage")
        || canReadMessagesAdmin();
    }

    function canManageInvestmentsAdmin() {
      return hasAdminPermission("investments.manage")
        || hasAdminPermission("financial.edit");
    }

    function canReadContractsAdmin() {
      return canReadMessagesAdmin()
        || hasAdminPermission("investments.view")
        || canManageInvestmentsAdmin()
        || hasAdminPermission("financial.view")
        || hasAdminPermission("reports.view");
    }

    function canManageContractsAdmin() {
      return canManageInvestmentsAdmin();
    }

    function canReadInterestRequestsAdmin() {
      return canReadMessagesAdmin()
        || canManageInvestmentsAdmin();
    }

    function isInvestmentClosedData(d) {
      return d.status in ["stopped", "completed", "closed"];
    }

    function isInvestmentTermsLocked() {
      return ("termsLockedAt" in resource.data)
        || (resource.data.status in ["approved", "signed", "active", "stopped", "completed", "closed"]);
    }

    function investmentTermsChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        "customRate",
        "customDuration",
        "annualReturnAtSign",
        "durationMonthsAtSign",
        "startAt",
        "plannedEndAt",
        "expectedProfit",
        "termsLockedAt",
        "legalTermsSnapshot"
      ]);
    }

    function clientSignedContractUpdateOnly() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      let currentStatus = investmentStatusValue(resource.data);
      let currentContractStatus = investmentContractStatusValue(resource.data);
      let needsResign = (
        (("signedContractOutdated" in resource.data) && resource.data.signedContractOutdated == true)
        || (("requiresResign" in resource.data) && resource.data.requiresResign == true)
        || (
          ("contractVersion" in resource.data)
          && resource.data.contractVersion is number
          && ("signedAgainstContractVersion" in resource.data)
          && request.resource.data.signedAgainstContractVersion is number
          && resource.data.contractVersion > request.resource.data.signedAgainstContractVersion
        )
      );
      return signedIn()
        && request.auth.uid == resource.data.investorUid
        && !isInvestmentClosedData(resource.data)
        && !(currentStatus in ["rejected", "cancelled"])
        && changed.hasOnly([
          "signedContract",
          "signedContractFile",
          "signedAgainstContractVersion",
          "signedContractOutdated",
          "requiresResign",
          "signedContractOutdatedAt",
          "signedAt",
          "status",
          "contractStatus",
          "lastDocumentUploadAt",
          "lastDocumentUploadBy"
        ])
        && (
          currentContractStatus in ["sent", "pending_signature"]
          || (currentContractStatus == "draft" && hasOriginalContractData(resource.data))
          || needsResign
        )
        && request.resource.data.status == "signed"
        && request.resource.data.contractStatus == "under_review"
        && request.resource.data.lastDocumentUploadBy == request.auth.uid;
    }

    function investmentStatusValue(data) {
      return ("status" in data && data.status is string) ? lower(data.status) : "";
    }

    function investmentContractStatusValue(data) {
      return ("contractStatus" in data && data.contractStatus is string)
        ? lower(data.contractStatus)
        : "";
    }

    function hasSignedContractData(data) {
      return (
        (("signedContract" in data)
          && ("path" in data.signedContract)
          && data.signedContract.path is string
          && data.signedContract.path.size() > 0)
        || (("signedContractFile" in data)
          && ("path" in data.signedContractFile)
          && data.signedContractFile.path is string
          && data.signedContractFile.path.size() > 0)
        || (("signedContractPath" in data)
          && data.signedContractPath is string
          && data.signedContractPath.size() > 0)
        || (("signedPath" in data)
          && data.signedPath is string
          && data.signedPath.size() > 0)
      );
    }

    function hasOriginalContractData(data) {
      return (
        (("originalContract" in data)
          && ("path" in data.originalContract)
          && data.originalContract.path is string
          && data.originalContract.path.size() > 0)
        || (("contractFile" in data)
          && ("path" in data.contractFile)
          && data.contractFile.path is string
          && data.contractFile.path.size() > 0)
        || (("originalContractPath" in data)
          && data.originalContractPath is string
          && data.originalContractPath.size() > 0)
        || (("originalPath" in data)
          && data.originalPath is string
          && data.originalPath.size() > 0)
        || (("contractPath" in data)
          && data.contractPath is string
          && data.contractPath.size() > 0)
        || (("documentPath" in data)
          && data.documentPath is string
          && data.documentPath.size() > 0)
      );
    }

    function isValidInvestmentWorkflowState(data) {
      let status = investmentStatusValue(data);
      let contractStatus = investmentContractStatusValue(data);
      return (
        (status in ["pending", "pending_review"] && contractStatus in ["", "draft"])
        || (status == "pending_contract" && contractStatus == "draft")
        || (status == "signing" && contractStatus in ["sent", "pending_signature"])
        || (status == "signed" && contractStatus in ["under_review", "approved"])
        || (status == "active" && contractStatus == "approved")
        || (status in ["stopped", "completed", "closed", "rejected", "cancelled"])
      );
    }

    function isValidInvestmentWorkflowTransition() {
      let beforeStatus = investmentStatusValue(resource.data);
      let afterStatus = investmentStatusValue(request.resource.data);
      let beforeContractStatus = investmentContractStatusValue(resource.data);
      let afterContractStatus = investmentContractStatusValue(request.resource.data);

      return isValidInvestmentWorkflowState(request.resource.data)
        && (
          beforeStatus == afterStatus
          || (beforeStatus in ["pending", "pending_review"] && afterStatus == "pending_contract")
          || (beforeStatus == "pending_contract" && afterStatus == "signing")
          || (beforeStatus == "signing" && afterStatus == "signed")
          || (beforeStatus == "signed" && afterStatus == "signing")
          || (beforeStatus == "signed" && afterStatus == "active")
          || (beforeStatus == "active" && afterStatus in ["stopped", "completed", "closed"])
          || (beforeStatus in ["pending_contract", "signing", "signed"] && afterStatus in ["rejected", "cancelled"])
        )
        && (
          afterStatus != "active"
          || (
            beforeStatus == "signed"
            && beforeContractStatus == "approved"
            && afterContractStatus == "approved"
            && ("startAt" in request.resource.data)
            && request.resource.data.startAt != null
            && ("plannedEndAt" in request.resource.data)
            && request.resource.data.plannedEndAt != null
            && ("termsLockedAt" in request.resource.data)
            && request.resource.data.termsLockedAt != null
            && ("legalTermsSnapshot" in request.resource.data)
            && request.resource.data.legalTermsSnapshot != null
            && hasSignedContractData(request.resource.data)
          )
        );
    }

    function requestStatusValue(data) {
      return ("status" in data && data.status is string) ? lower(data.status) : "";
    }

    function requestHasInvestment(data) {
      return ("investmentId" in data)
        && (data.investmentId is string)
        && data.investmentId.size() > 0;
    }

    function currentUserOwnsInvestment(investmentId) {
      return signedIn()
        && investmentId is string
        && investmentId.size() > 0
        && exists(/databases/$(database)/documents/investments/$(investmentId))
        && get(/databases/$(database)/documents/investments/$(investmentId)).data.investorUid == request.auth.uid;
    }

    function currentUserCanReadContract() {
      return signedIn() && (
        (("investorUid" in resource.data)
          && resource.data.investorUid is string
          && resource.data.investorUid == request.auth.uid)
        || (("userId" in resource.data)
          && resource.data.userId is string
          && resource.data.userId == request.auth.uid)
        || (("investmentId" in resource.data)
          && currentUserOwnsInvestment(resource.data.investmentId))
      );
    }

    function isValidInterestRequestCreate() {
      return signedIn()
        && request.resource.data.investorUid == request.auth.uid
        && requestStatusValue(request.resource.data) == "pending"
        && (!("type" in request.resource.data) || request.resource.data.type == "investment_request")
        && (!requestHasInvestment(request.resource.data));
    }

    function isValidInterestRequestUpdateByOps() {
      let beforeStatus = requestStatusValue(resource.data);
      let afterStatus = requestStatusValue(request.resource.data);
      let beforeHasInvestment = requestHasInvestment(resource.data);
      let afterHasInvestment = requestHasInvestment(request.resource.data);

      return (
        beforeStatus == afterStatus
        || (beforeStatus in ["pending", "new"] && afterStatus == "reviewing")
        || (beforeStatus in ["reviewing", "in_progress", "needs_account", "waiting_client_confirmation"] && afterStatus == "approved")
        || (beforeStatus == "approved" && afterStatus == "completed")
        || (beforeStatus in ["pending", "reviewing", "approved"] && afterStatus == "rejected")
        || (beforeStatus in ["rejected", "completed", "closed"] && afterStatus == "reviewing")
      )
      && (
        beforeHasInvestment
        || !afterHasInvestment
        || (beforeStatus == "approved" && afterStatus == "approved")
      )
      && (
        afterStatus != "completed"
        || (
          ("investmentStatus" in request.resource.data)
          && lower(request.resource.data.investmentStatus) == "active"
        )
      );
    }

    /* =========================
       settings
    ========================= */
    match /settings/{docId} {
      allow read: if true;
      allow write: if hasAdminPermission("settings.manage");
    }

    /* =========================
       projects
    ========================= */
match /projects/{projectId} {
  allow read: if true;
  allow create, delete: if hasAdminPermission("projects.manage");

  // ✅ المحاسب + الأدمن يقدرون يحدثون status + aggregates
  allow update: if hasAdminPermission("projects.manage")
    || hasAdminPermission("projects.publish");
}


    /* =========================
       users  ✅ أهم إصلاح
       - خلّينا create مرن عشان useAuth يقدر ينشئ الوثيقة
       - المستخدم يقرأ/يعدل وثيقته
       - ops يقرأ الجميع (للوحات الإدارة)
    ========================= */
    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || canReadUsersAdmin();

      // ✅ create: أقل شروط ممكنة (عشان ما ينهار ensureUserDoc)
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && isValidRoleOnCreate();

      allow update: if canManageUsersAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && isValidRoleOnUpdate()
      );

      allow delete: if canManageUsersAdmin();

      function isValidRoleOnCreate() {
        // يسمح guest/client افتراضياً
        // ويسمح owner فقط لحسابك (bootstrap)
        return (!("role" in request.resource.data)
          || request.resource.data.role in ["guest","client"]
          || (request.resource.data.role == "owner" && isBootstrapOwnerEmail()))
          && (!("permissionsAllow" in request.resource.data) || request.resource.data.permissionsAllow.size() == 0)
          && (!("permissionsDeny" in request.resource.data) || request.resource.data.permissionsDeny.size() == 0)
          && (!("active" in request.resource.data) || request.resource.data.active == true);
      }

      function isValidRoleOnUpdate() {
        // المستخدم ما يغير role بنفسه (إلا admin)
        // نسمح له بتعديل بياناته فقط
        let keys = request.resource.data.diff(resource.data).changedKeys();
        return !keys.hasAny([
            "role",
            "permissionsAllow",
            "permissionsDeny",
            "active",
            "isActive",
            "isInvestor",
            "vipStatus",
            "linkedUserUid"
          ]) // المستخدم ممنوع يغيّر صلاحياته/حالة الحساب
          && (!keys.hasAny(["email"]) || request.resource.data.email == request.auth.token.email)
          && (!keys.hasAny(["uid"]) || request.resource.data.uid == request.auth.uid);
      }
    }

    /* =========================
       messages ✅ إصلاح list
       - Ops: يشوف الكل
       - Client: يشوف فقط اللي createdByUid == uid (مستوى الأمان الحقيقي يحتاج تغيير مسار البيانات)
       - حالياً نخلي list للـ client مسموح عشان التطبيق يشتغل
    ========================= */
    match /messages/{messageId} {
      allow create: if true;

      allow get, list: if canReadMessagesAdmin();

      allow get: if isClient() && resource.data.createdByUid == request.auth.uid;

      // ✅ مؤقت لتشغيل الواجهة (احذف شرط request.query.where الغير مدعوم)
      allow list: if isClient();

      allow update: if canManageMessagesAdmin();
      allow delete: if canManageMessagesAdmin();
    }

    /* =========================
       investments
    ========================= */
    match /investments/{investmentId} {
      allow read: if (signedIn() && request.auth.uid == resource.data.investorUid) || canReadInvestmentsAdmin();

      allow create: if (canManageInvestmentsAdmin() && isValidInvestmentWorkflowState(request.resource.data)
        && investmentStatusValue(request.resource.data) != "active") || (
        signedIn()
        && request.resource.data.investorUid == request.auth.uid
        && (request.resource.data.status == "pending_review" || request.resource.data.status == "pending")
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.projectId is string
        && request.resource.data.projectId.size() > 0
        && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
      );

      allow update: if (
        canManageInvestmentsAdmin()
          && !isInvestmentClosedData(resource.data)
          && (!isInvestmentTermsLocked() || !investmentTermsChanged())
          && isValidInvestmentWorkflowTransition()
      ) || clientSignedContractUpdateOnly();

      allow delete: if canManageInvestmentsAdmin()
        && !isInvestmentClosedData(resource.data);
    }

    /* =========================
       contracts
    ========================= */
    match /contracts/{contractId} {
      allow get: if canReadContractsAdmin() || currentUserCanReadContract();
      allow list: if canReadContractsAdmin();
      allow create, update: if canManageContractsAdmin();
      allow delete: if canManageContractsAdmin();
    }

    /* =========================
       notifications ✅ مهم
       - غالباً “ارسال الطلب” يكتب هنا
    ========================= */
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if canManageMessagesAdmin()
        || canManageInvestmentsAdmin()
        || canManageUsersAdmin()
        || hasAdminPermission("settings.manage");
      allow update: if (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["isRead", "updatedAt"])
      ) || canManageMessagesAdmin()
        || canManageInvestmentsAdmin()
        || canManageUsersAdmin()
        || hasAdminPermission("settings.manage");
      allow delete: if canManageMessagesAdmin()
        || canManageInvestmentsAdmin()
        || canManageUsersAdmin()
        || hasAdminPermission("settings.manage");
    }

match /admin_users/{docId} {
  // ✅ أي شخص يقرأ وثيقته فقط (docId = email lower)
  allow read: if signedIn()
    && (
      hasAdminPermission("settings.manage")
      || (
        lower(request.auth.token.email) != ""
        && docId == lower(request.auth.token.email)
      )
    );

  // ✅ التعديل/الإنشاء/الحذف للإدارة فقط
  allow create, update, delete: if hasAdminPermission("settings.manage");
}


 match /role_invites/{docId} {
  allow read, write: if hasAdminPermission("settings.manage");
}


    /* =========================
       interest_requests ✅ (مخفف عشان يشتغل الإرسال)
    ========================= */
    match /interest_requests/{id} {
      // العميل يرسل طلبه (المهم يطابق investorUid)
      allow create: if isValidInterestRequestCreate();

      // العميل يشوف طلباته فقط + ops يشوف الكل
      allow read: if canReadInterestRequestsAdmin()
        || (signedIn() && resource.data.investorUid == request.auth.uid);

      // التعديل/الحذف للإدارة فقط
      allow update: if (canManageMessagesAdmin() || canManageInvestmentsAdmin())
        && isValidInterestRequestUpdateByOps();
      allow delete: if canManageMessagesAdmin() || canManageInvestmentsAdmin();
    }

    /* =========================
       audit_logs
       - Read: owner/admin only
       - Client writes are blocked; audit entries are created via trusted server code
       - Append-only from the application's point of view
    ========================= */
    match /audit_logs/{id} {
      allow read: if hasAdminPermission("settings.manage");
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
